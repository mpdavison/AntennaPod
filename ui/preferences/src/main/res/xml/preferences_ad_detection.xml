<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreferenceCompat
            android:key="prefAdDetectionEnabled"
            android:title="@string/pref_ad_detection_enabled_title"
            android:summary="@string/pref_ad_detection_enabled_sum"
            android:defaultValue="false"/>

    <de.danoeh.antennapod.ui.preferences.preference.MaterialListPreference
            android:key="prefAdDetectionMode"
            android:title="@string/pref_ad_detection_mode_title"
            android:entries="@array/pref_ad_detection_mode_entries"
            android:entryValues="@array/pref_ad_detection_mode_values"
            android:defaultValue="direct"/>

    <EditTextPreference
            android:key="prefAdProxyBaseUrl"
            android:title="@string/pref_ad_proxy_base_url_title"
            android:summary="@string/pref_ad_proxy_base_url_sum"
            android:inputType="textUri"/>

    <PreferenceCategory
            android:key="prefAdTranscriptionCategory"
            android:title="@string/pref_ad_transcription_category">
        <de.danoeh.antennapod.ui.preferences.preference.MaterialListPreference
                android:key="prefAdTranscriptionActiveProfile"
                android:title="@string/pref_ad_active_profile_title"/>
        <Preference
                android:key="prefAdTranscriptionManage"
                android:title="@string/pref_ad_manage_profiles_title"/>
    </PreferenceCategory>

    <PreferenceCategory
            android:key="prefAdChatCategory"
            android:title="@string/pref_ad_chat_category">
        <de.danoeh.antennapod.ui.preferences.preference.MaterialListPreference
                android:key="prefAdChatActiveProfile"
                android:title="@string/pref_ad_active_profile_title"/>
        <Preference
                android:key="prefAdChatManage"
                android:title="@string/pref_ad_manage_profiles_title"/>
    </PreferenceCategory>

</PreferenceScreen>
